<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Every string exists in all five languages, or the build fails. -->
    <issue id="MissingTranslation" severity="error" />
    <issue id="ExtraTranslation" severity="error" />
    <!-- Renovate owns version updates; lint must not fail a build because a newer release exists. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- targetSdk follows Google Play's requirement, compileSdk follows the Compose BOM. -->
    <issue id="OldTargetApi" severity="ignore" />
    <!-- A themed icon flattens the mark's gradient: a new brand variant that waits for the brand owner. -->
    <issue id="MonochromeLauncherIcon" severity="ignore" />
</lint>
